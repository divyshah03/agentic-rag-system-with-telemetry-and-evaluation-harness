# Copy to .env for local dev and fill in real values. Never commit .env.
# See README.md "Environment Variables" for which of these belong on which
# hosting dashboard instead of in a local .env file.

# --- Required everywhere the backend runs ---
OPENAI_API_KEY=

# --- Local dev only ---
# Set to 1 so the Inngest SDK talks to `inngest dev` instead of Inngest Cloud.
INNGEST_DEV=1

# --- Qdrant (backend only; unset locally to use the Docker default) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Inngest Cloud (leave unset for local dev against `inngest dev`) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_API_BASE=http://127.0.0.1:8288/v1

# --- Streamlit frontend only ---
# URL of the deployed FastAPI backend (e.g. https://your-app.onrender.com)
BACKEND_URL=http://127.0.0.1:8000
